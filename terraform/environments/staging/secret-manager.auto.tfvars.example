# Secret Manager configuration for Staging environment
# Copy this file to secret-manager.auto.tfvars and fill in the values

# Backend API URL (Cloud Run URL)
# Get from: gcloud run services describe ledger-muse-api-staging --region asia-northeast1 --format='value(status.url)'
backend_api_url = "https://ledger-muse-api-staging-<hash>-an.a.run.app"

# Note: Service account permissions are managed by Firebase CLI
# After running terraform apply, execute:
# firebase apphosting:secrets:grantaccess BACKEND_API_BASE_STAGING --backend staging --location asia-east1 --project <PROJECT_ID>
