# Frontend environment variables (local development)
NEXT_PUBLIC_BACKEND_API_BASE=http://localhost:8080
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-no-project
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=http://localhost:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=localhost:9000
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=http://localhost:9199

# Optional: override Firebase Auth emulator origin if you proxy
# NEXT_PUBLIC_AUTH_EMULATOR_HOST_FOR_BROWSER=http://127.0.0.1:9099

# NextAuth / Identity Platform
AUTH_SECRET=replace-with-random-string
AUTH_GOOGLE_ID=replace-with-client-id
AUTH_GOOGLE_SECRET=replace-with-client-secret
# Optional: set if you use a custom issuer (e.g. Identity Platform)
# AUTH_GOOGLE_ISSUER=https://accounts.google.com
# AUTH_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
