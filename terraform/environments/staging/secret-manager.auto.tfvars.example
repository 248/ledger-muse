# Secret Manager configuration for Staging environment
# Copy this file to secret-manager.auto.tfvars and fill in the values

# Backend API URL (Cloud Run URL)
# Get from: gcloud run services describe ledger-muse-api-staging --region asia-northeast1 --format='value(status.url)'
backend_api_url = "https://ledger-muse-api-staging-<hash>-an.a.run.app"

# Service accounts that can access the backend API URL secret
# App Hosting service account format: service-<PROJECT_NUMBER>@gcp-sa-firebase-apphosting.iam.gserviceaccount.com
# Get PROJECT_NUMBER from: gcloud projects describe <PROJECT_ID> --format='value(projectNumber)'
backend_api_url_secret_accessors = [
  "serviceAccount:service-<PROJECT_NUMBER>@gcp-sa-firebase-apphosting.iam.gserviceaccount.com"
]
